{
  "name": "jaga-igd",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx --env-file-if-exists=.env server/local.ts\" \"vite\"",
    "db:setup": "tsx --env-file-if-exists=.env server/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/engine.test.ts",
    "test:integration": "tsx --env-file-if-exists=.env --test tests/integration.test.ts",
    "build": "npm run typecheck && vite build",
    "test:browser": "tsx --test tests/browser.test.ts",
    "test:deployment": "tsx --test tests/deployment.test.ts"
  },
  "dependencies": {
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
